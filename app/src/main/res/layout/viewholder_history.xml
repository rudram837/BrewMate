<?xml version="1.0" encoding="utf-8"?>
<!-- Wrapped inside MaterialCardView for Premium White Card look -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Product Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/picHistory"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:src="@drawable/turk"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircleImageView" />

        <!-- Order Title -->
        <TextView
            android:id="@+id/titleHistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            android:fontFamily="@font/instagram_sans_bold"
            android:text="@string/title"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            app:layout_constraintEnd_toStartOf="@+id/actionLayout"
            app:layout_constraintStart_toEndOf="@+id/picHistory"
            app:layout_constraintTop_toTopOf="@+id/picHistory" />

        <!-- Each Item Price -->
        <TextView
            android:id="@+id/priceHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/instagram_sans_medium"
            android:text="@string/eachprice"
            android:textColor="#757575"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@+id/titleHistory"
            app:layout_constraintTop_toBottomOf="@+id/titleHistory" />

        <!-- Total Paid Amount -->
        <TextView
            android:id="@+id/totalAmountHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instagram_sans_bold"
            android:text="@string/paid_amount"
            android:textColor="#FF7A00"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/picHistory"
            app:layout_constraintStart_toStartOf="@+id/titleHistory" />

        <!-- Action Area (Tick Icon & Quantity) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/actionLayout"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/picHistory"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/picHistory">

            <!-- Order Received Tick -->
            <ImageView
                android:id="@+id/orderReceivedBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/tick_green_"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Total Quantity -->
            <TextView
                android:id="@+id/totalQuantityHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/instagram_sans_medium"
                android:text="@string/ouantity"
                android:textColor="#757575"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>