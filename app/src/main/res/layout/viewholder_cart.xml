<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:layout_marginHorizontal="4dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Product Image (Restored size for better height) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/picCartt"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:src="@drawable/turk"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircleImageView" />

        <!-- Product Title (Wrapped to avoid hitting delete icon) -->
        <TextView
            android:id="@+id/titleCarttttxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/instagram_sans_bold"
            android:text="title"
            android:textColor="#1A1A1A"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@+id/constraintLayout"
            app:layout_constraintStart_toEndOf="@+id/picCartt"
            app:layout_constraintTop_toTopOf="@+id/picCartt" />

        <!-- Unit Price -->
        <TextView
            android:id="@+id/feeEachItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/instagram_sans_medium"
            android:text="$0"
            android:textColor="#757575"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@+id/titleCarttttxt"
            app:layout_constraintTop_toBottomOf="@+id/titleCarttttxt" />

        <!-- Total Item Price -->
        <TextView
            android:id="@+id/totalEachItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instagram_sans_bold"
            android:text="₹0"
            android:textColor="#FF7A00"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/picCartt"
            app:layout_constraintStart_toStartOf="@+id/titleCarttttxt" />

        <!-- Actions Layout (Locked height to Image for perfect Top/Bottom spacing) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/picCartt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/picCartt">

            <!-- Delete Icon -->
            <ImageView
                android:id="@+id/removeCart"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/delete_cart_item_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Plus Button (Increased size to stop text clipping) -->
            <TextView
                android:id="@+id/plusCartItem"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/glass_orange"
                android:gravity="center"
                android:text="@string/plus"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Quantity Text -->
            <TextView
                android:id="@+id/numberItemCartTxt"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginHorizontal="16dp"
                android:fontFamily="@font/instagram_sans_bold"
                android:gravity="center"
                android:text="@string/_1"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/plusCartItem" />

            <!-- Minus Button (Increased size to stop text clipping) -->
            <TextView
                android:id="@+id/minusCartItem"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/glass_white"
                android:gravity="center"
                android:text="@string/minus"
                android:textColor="#FF7A00"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/numberItemCartTxt" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>