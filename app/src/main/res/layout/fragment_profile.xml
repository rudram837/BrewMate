<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frameLayout2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    tools:context=".view.Fragment.ProfileFragment">

    <!-- Original views kept hidden so your backend code doesn't crash -->
    <View
        android:id="@+id/view4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/view2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/view3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:ignore="MissingConstraints" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Profile Header -->
            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="48dp"
                android:fontFamily="@font/instagram_sans_bold"
                android:text="My Account"
                android:textColor="#111827"
                android:textSize="34sp" />

            <!-- 3 Floating Premium Tiles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Tile 1: Edit -->
                <LinearLayout
                    android:id="@+id/edit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="8dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/editicon"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/edit"
                                app:tint="#424040" />

                            <TextView
                                android:id="@+id/settxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:fontFamily="@font/instagram_sans_bold"
                                android:text="@string/edit_profile"
                                android:textColor="#111827"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Tile 2: Photo -->
                <LinearLayout
                    android:id="@+id/photo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="8dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/picicon"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/camera_svgrepo" />

                            <TextView
                                android:id="@+id/camtxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:fontFamily="@font/instagram_sans_bold"
                                android:text="@string/photo"
                                android:textColor="#111827"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Tile 3: Logout -->
                <LinearLayout
                    android:id="@+id/signoutlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="8dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/signoutBtn"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/logout_3_svgrepo"
                                app:tint="#EF4444" />

                            <TextView
                                android:id="@+id/walltetxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:fontFamily="@font/instagram_sans_bold"
                                android:text="@string/logout"
                                android:textColor="#EF4444"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/instagram_sans_bold"
                android:text="Personal Details"
                android:textAllCaps="true"
                android:textColor="#9CA3AF"
                android:textSize="14sp" />

            <!-- Apple/Settings Style Right-Aligned Form Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:paddingHorizontal="20dp">

                        <TextView
                            android:id="@+id/textView26"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:fontFamily="@font/instagram_sans_medium"
                            android:text="@string/name"
                            android:textColor="#6B7280"
                            android:textSize="16sp" />

                        <!-- Right aligned text for premium feel -->
                        <EditText
                            android:id="@+id/name"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.5"
                            android:background="@null"
                            android:fontFamily="@font/instagram_sans_bold"
                            android:gravity="start|center_vertical"
                            android:paddingStart="16dp"
                            android:singleLine="true"
                            android:textAlignment="viewStart"
                            android:textColor="#111827"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <!-- Inset Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="20dp"
                        android:background="#F3F4F6" />

                    <!-- Email -->
                    <LinearLayout
                        android:id="@+id/email_lay"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:weightSum="2"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">

                        <TextView
                            android:id="@+id/textView24"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/instagram_sans_medium"
                            android:text="@string/e_mail"
                            android:textColor="#6B7280"
                            android:layout_weight="0.5"
                            android:textSize="16sp" />

                        <EditText
                            android:id="@+id/mail"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.5"
                            android:background="@null"
                            android:fontFamily="@font/instagram_sans_bold"
                            android:gravity="start|center_vertical"
                            android:inputType="textEmailAddress"
                            android:paddingStart="16dp"
                            android:singleLine="true"
                            android:textAlignment="viewStart"
                            android:textColor="#111827"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="20dp"
                        android:background="#F3F4F6" />

                    <!-- Address (TextView kept exactly as per original ID requirement) -->
                    <LinearLayout
                        android:id="@+id/add_lay"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:weightSum="2"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">

                        <TextView
                            android:id="@+id/add_id"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.4"
                            android:fontFamily="@font/instagram_sans_medium"
                            android:text="@string/address"
                            android:textColor="#6B7280"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/add_edit"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.6"
                            android:background="@null"
                            android:fontFamily="@font/instagram_sans_bold"
                            android:gravity="start|center_vertical"
                            android:paddingStart="16dp"
                            android:singleLine="true"
                            android:textAlignment="viewStart"
                            android:textColor="#111827"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="20dp"
                        android:background="#F3F4F6" />

                    <!-- Phone -->
                    <LinearLayout
                        android:id="@+id/phone_lay"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:weightSum="2"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">

                        <TextView
                            android:id="@+id/phone_id"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.4"
                            android:fontFamily="@font/instagram_sans_medium"
                            android:text="@string/phone_no"
                            android:textColor="#6B7280"
                            android:textSize="16sp" />

                        <EditText
                            android:id="@+id/phone_edit"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.6"
                            android:background="@null"
                            android:fontFamily="@font/instagram_sans_bold"
                            android:gravity="start|center_vertical"
                            android:inputType="number"
                            android:paddingStart="16dp"
                            android:singleLine="true"
                            android:textAlignment="viewStart"
                            android:textColor="#111827"
                            android:textSize="16sp"
                            tools:ignore="TextFields" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Button fixed to bottom of screen permanently -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:cardBackgroundColor="#FF7A00"
            app:cardCornerRadius="30dp"
            app:cardElevation="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/save"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/instagram_sans_bold"
                android:text="@string/save_information"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>