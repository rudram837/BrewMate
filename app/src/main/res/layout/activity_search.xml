<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FB"
    tools:context=".view.Activity.SearchActivity">

    <TextView
        android:id="@+id/header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/instagram_sans_medium"
        android:text="Search Coffee"
        android:textColor="#2D211B"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/header_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/instagram_sans_medium"
        android:text="Discover your favorite drinks"
        android:textColor="#8C7A6B"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_title" />

    <EditText
        android:id="@+id/search1"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/searchview"
        android:elevation="4dp"
        android:ems="10"
        android:focusable="true"
        android:fontFamily="@font/instagram_sans_medium"
        android:hint="Search for Coffees..."
        android:inputType="textFilter"
        android:paddingStart="18dp"
        android:paddingEnd="20dp"
        android:textColor="#2D211B"
        android:textColorHint="#A89F95"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_subtitle" />

    <ImageView
        android:id="@+id/go_back_home"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="9dp"
        android:background="@drawable/card_back_btn"
        android:elevation="6dp"
        android:padding="10dp"
        android:scaleX="1"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/search1"
        app:layout_constraintStart_toStartOf="@+id/search1"
        app:layout_constraintTop_toTopOf="@+id/search1"
        app:srcCompat="?attr/actionModeCloseDrawable"
        app:tint="#2D211B" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search1"
        tools:listitem="@layout/viewholder_search" />

</androidx.constraintlayout.widget.ConstraintLayout>