<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- MAIN BULGE BODY -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="220"
                android:centerX="0.5"
                android:centerY="0.25"
                android:startColor="#FFFFFF"
                android:endColor="#DADADA"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>

    <!-- INNER SHADOW (edge thickness) -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="#22000000"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>

    <!-- SPECULAR LIGHT STREAK -->
    <item
        android:top="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#80FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="180"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>

    <!-- TIGHT DROP SHADOW -->
    <item
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#20000000"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>

</layer-list>