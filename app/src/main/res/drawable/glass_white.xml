<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- YOUR EXISTING BACKGROUND -->
    <item android:drawable="@drawable/white_bg1"/>

    <!-- Liquid shine layer -->
    <item>
        <shape>
            <gradient
                android:startColor="#AAFFFFFF"
                android:centerColor="#40FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="135"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

    <!-- Soft glass border -->
    <item>
        <shape>
            <stroke
                android:width="1dp"
                android:color="#60FFFFFF"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

</layer-list>

